# ==============================================================================
# SAFE CONFIGURATION TEMPLATE - E-Commerce CDC Lakehouse Pipeline
# ==============================================================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL & MySQL CDC Sources
POSTGRES_CDC_HOST=localhost
POSTGRES_CDC_PORT=5432
POSTGRES_CDC_DB=ecommerce_oltp
POSTGRES_CDC_USER=debezium_cdc_user
POSTGRES_CDC_SLOT_NAME=debezium_replication_slot

# Apache Kafka / Redpanda Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CDC_TOPIC_PREFIX=cdc.ecommerce
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Apache Iceberg & MinIO Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_secure_password_sample
ICEBERG_WAREHOUSE_BUCKET=s3://ecommerce-lakehouse/
ICEBERG_CATALOG_NAME=ecommerce_iceberg_catalog

# dbt & DuckDB
DBT_PROFILES_DIR=./dbt_lakehouse
DUCKDB_DATABASE_PATH=./data/lakehouse.duckdb
